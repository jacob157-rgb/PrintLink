<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PrintLink.Desktop</RootNamespace>
    <AssemblyName>PrintLink.Desktop</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintLink.Core\PrintLink.Core.csproj" />
    <ProjectReference Include="..\PrintLink.Spooler\PrintLink.Spooler.csproj" />
    <ProjectReference Include="..\PrintLink.Network\PrintLink.Network.csproj" />
    <ProjectReference Include="..\PrintLink.Storage\PrintLink.Storage.csproj" />
    <ProjectReference Include="..\PrintLink.Service\PrintLink.Service.csproj" />
    <ProjectReference Include="..\PrintLink.Diagnostics\PrintLink.Diagnostics.csproj" />
  </ItemGroup>

</Project>
