<Window x:Class="PrintLink.Desktop.Views.ModernDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirmation"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="440"
        MaxWidth="620"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogDangerButton" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="#000000" Opacity="0.65" ShadowDepth="4" />
        </Border.Effect>

        <!-- Main Card Border -->
        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header: Icon + Title + Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Pill Badge -->
                    <Border x:Name="IconBadgeBorder" Grid.Column="0" Width="44" Height="44" CornerRadius="12" 
                            Background="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="IconTextBlock" Text="💬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Dialog Title -->
                    <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Text="Confirmation" 
                               Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextWrapping="Wrap" />

                    <!-- Optional Close X -->
                    <Button Grid.Column="2" Content="✕" Foreground="#94A3B8" Background="Transparent" BorderThickness="0"
                            FontSize="14" FontWeight="Bold" Width="28" Height="28" Cursor="Hand" Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Message Body -->
                <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24">
                    <TextBlock x:Name="MessageTextBlock" Foreground="#CBD5E1" FontSize="13" LineHeight="20"
                               TextWrapping="Wrap" Text="Are you sure you want to proceed?" />
                </ScrollViewer>

                <!-- Action Buttons Row -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource DialogSecondaryButton}"
                            Margin="0,0,10,0" Click="CancelButton_Click" />
                    <Button x:Name="PrimaryButton" Content="Confirm" Style="{StaticResource DialogPrimaryButton}"
                            Click="ConfirmButton_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
